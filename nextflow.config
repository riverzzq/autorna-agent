/*
 * AutoRNA Agent — Nextflow config
 * Start local. No cloud profile in Week 1 (see README.md scope note).
 */

params {
    input           = null
    outdir          = "results"
    transcriptome   = null
    gtf             = null
    // Optional pre-built Salmon index directory. Leave null to build
    // the index from --transcriptome (default, avoids version mismatch).
    salmon_index    = null
    // QC-gate starting point, NOT a validated threshold — see docs/qc-gates.md.
    // Tune it after the first real runs and record why you changed it.
    min_mapping_rate = 0.5
    max_memory      = '8.GB'
    max_cpus        = 4
    max_time        = '6.h'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'

    withLabel: process_single {
        cpus   = 1
        memory = '2.GB'
        time   = '1.h'
    }
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '6.h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        // NOTE: on macOS / Windows Docker Desktop, -u may need removing.
        // See README.md troubleshooting.
    }

    singularity {
        singularity.enabled   = true
        singularity.autoMounts = true
        // On an HPC login node, set NXF_SINGULARITY_CACHEDIR to a
        // writable cache dir if the default is read-only.
    }

    // Week 1 smoke-test profile. Assumes scripts/fetch_test_data.sh
    // has been run first (it downloads the small yeast test data into
    // data/). Do NOT run -profile test before fetching the data.
    test {
        params.input         = 'data/samplesheet_test_3v3.csv'
        params.transcriptome = 'data/reference/transcriptome.fasta.gz'
        params.gtf           = 'data/reference/genes.gtf.gz'
        params.outdir        = 'results/test'
    }
}

manifest {
    name            = 'autorna-agent'
    description     = 'Agent-driven RNA-seq pipeline: FastQC -> Salmon -> MultiQC, with run logging and QC gates'
    author          = 'River Zhu (riverzzq)'
    homePage        = 'https://github.com/riverzzq'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0-week1'
}

timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
